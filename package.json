  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahlawatansh/Scribo.git"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm run firebase -- deploy",
    "deploy:hosting": "npm run build && npm run firebase -- deploy --only hosting",
    "deploy:functions": "npm run firebase -- deploy --only functions",
    "deploy:firestore": "npm run firebase -- deploy --only firestore",
    "deploy:backend": "npm run firebase -- deploy --only firestore,functions",
    "firebase": "firebase",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.14.0",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.19.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.10",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.8",
    "@rollup/rollup-darwin-arm64": "^4.63.2",
    "lightningcss-darwin-arm64": "^1.33.0"
  }
